# --- Server ---
PORT=8884
NODE_ENV=development

# --- Security (required in production) ---
# Long random string used to sign console session tokens
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# OPTIONAL. Leave empty to keep the delivery-report endpoints open as before.
# If you set it, also add ?token=<value> to the callback URLs configured at Bulk360 / VerifyWay.
DLR_WEBHOOK_SECRET=

# Browser origins allowed to call the API cross-origin (comma separated). Same-origin is always allowed.
ALLOWED_ORIGINS=

# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/otp88

# --- Email OTP (Resend) ---
# RESEND_DOMAIN_ID is optional; it only powers the "domain verified" indicator in the admin console.
RESEND_API_KEY=
RESEND_DOMAIN_ID=
EMAIL_FROM=OTP88 <noreply@otp88.top>
EMAIL_SENDER_DOMAIN=otp88.top

# --- SMS OTP (Bulk360 / SMS360) ---
# OPTIONAL if the keys are already saved in the admin console (Admin > SMS OTP > API Credentials).
# Console values take precedence over these.
SMS360_APP_KEY=
SMS360_APP_SECRET=
SMS360_SENDER_ID=66688
SMS360_SEND_URL=https://sms.360.my/gw/bulk360/v3_0/send.php
SMS360_BALANCE_URL=https://sms.360.my/api/balance/v3_0/getBalance

# --- WhatsApp OTP (VerifyWay) ---
# OPTIONAL if the key is already saved in the admin console (Admin > WhatsApp OTP > API Credentials).
VERIFYWAY_API_KEY=
VERIFYWAY_API_URL=https://api.verifyway.com/api/v1/
